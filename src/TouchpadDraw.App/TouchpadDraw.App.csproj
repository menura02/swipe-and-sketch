<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TouchpadDrawHelper</AssemblyName>
    <Version>1.1.1</Version>
    <Product>Swipe &amp; Sketch</Product>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../TouchpadDraw.Core/TouchpadDraw.Core.csproj" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/*.ico"><LogicalName>TouchpadDraw.Assets.%(Filename)%(Extension)</LogicalName></EmbeddedResource></ItemGroup>
</Project>
